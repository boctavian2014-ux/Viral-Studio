# Viral Studio Services local/Railway example

VIRAL_STUDIO_HOST=0.0.0.0
VIRAL_STUDIO_PORT=4317

# Optional bearer auth shared with callers
VIRAL_STUDIO_API_KEY=change-me

# Railway will usually provide these from attached services
VIRAL_STUDIO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/viralstudio
VIRAL_STUDIO_REDIS_URL=redis://127.0.0.1:6379
VIRAL_STUDIO_QUEUE_KEY=viral-studio:pipeline-jobs

# Worker tuning
VIRAL_STUDIO_WORKER_POLL_MS=1000
VIRAL_STUDIO_WORKER_PROCESS_MS=750
